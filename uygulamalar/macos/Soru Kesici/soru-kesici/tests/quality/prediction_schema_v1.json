{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://soru-kesici.local/schemas/predictions-v1.json",
  "title": "Soru Kesici Prediction Report V1",
  "type": "object",
  "required": ["schema_version", "documents"],
  "properties": {
    "schema_version": {"const": "soru-kesici.predictions/v1"},
    "generator": {"type": "object"},
    "documents": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "source", "pages"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "source": {"type": "string", "minLength": 1},
          "source_hash": {"type": "string"},
          "pages": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["page", "width", "height", "role", "questions"],
              "properties": {
                "page": {"type": "integer", "minimum": 1},
                "width": {"type": "number", "exclusiveMinimum": 0},
                "height": {"type": "number", "exclusiveMinimum": 0},
                "role": {
                  "enum": [
                    "kapak", "icindekiler", "konu", "soru", "cozum",
                    "cevap_anahtari", "karma", "bilinmiyor"
                  ]
                },
                "role_confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
                "layout_family": {"type": "string"},
                "questions": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["id", "box", "type", "confidence"],
                    "properties": {
                      "id": {"type": "string", "minLength": 1},
                      "box": {
                        "type": "array",
                        "items": {"type": "number"},
                        "minItems": 4,
                        "maxItems": 4
                      },
                      "type": {
                        "enum": [
                          "coktan_secmeli", "acik_uclu", "kisa_cevapli",
                          "dogru_yanlis", "eslestirme", "karma", "bilinmiyor"
                        ]
                      },
                      "confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
                      "status": {"enum": ["otomatik", "incele", "reddedildi", "bilinmiyor"]},
                      "evidence": {"type": "array", "items": {"type": "string"}},
                      "warnings": {"type": "array", "items": {"type": "string"}}
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
