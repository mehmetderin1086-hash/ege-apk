{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://soru-kesici.local/schemas/predictions-v2.json",
  "title": "Soru Kesici Prediction Report V2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "documents"],
  "properties": {
    "schema_version": {"const": "soru-kesici.predictions/v2"},
    "quality_mode": {"enum": ["strict", "balanced", "legacy"]},
    "generator": {"type": "object"},
    "documents": {"type": "array", "items": {"$ref": "#/$defs/document"}}
  },
  "$defs": {
    "box": {
      "type": "array",
      "prefixItems": [{"type": "number", "minimum": 0}, {"type": "number", "minimum": 0}, {"type": "number", "exclusiveMinimum": 0}, {"type": "number", "exclusiveMinimum": 0}],
      "items": false,
      "minItems": 4,
      "maxItems": 4
    },
    "part": {
      "type": "object",
      "additionalProperties": false,
      "required": ["box"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "page": {"type": "integer", "minimum": 1},
        "box": {"$ref": "#/$defs/box"},
        "kind": {"enum": ["soru_govdesi", "devam", "ortak_uyaran", "sekil", "tablo", "formul", "diger"]}
      }
    },
    "output": {
      "type": "object",
      "properties": {
        "produced": {"type": "boolean"},
        "question_number": {"type": ["integer", "string", "null"]},
        "part_count": {"type": "integer", "minimum": 0},
        "image_width": {"type": "integer", "minimum": 1},
        "image_height": {"type": "integer", "minimum": 1},
        "metadata": {"type": "object"}
      }
    },
    "candidate": {
      "type": "object",
      "required": ["id", "type", "confidence"],
      "anyOf": [{"required": ["box"]}, {"required": ["parts"]}],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "number": {"type": ["integer", "string", "null"]},
        "box": {"$ref": "#/$defs/box"},
        "parts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/part"}},
        "type": {"enum": ["coktan_secmeli", "acik_uclu", "kisa_cevapli", "dogru_yanlis", "eslestirme", "karma", "bilinmiyor"]},
        "confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "status": {"enum": ["otomatik", "incele", "reddedildi", "bilinmiyor", "onaylandi"]},
        "evidence": {"type": "array", "items": {"type": "string"}},
        "warnings": {"type": "array", "items": {"type": "string"}},
        "source_methods": {"type": "array", "items": {"type": "string"}},
        "risk_reasons": {"type": "array", "items": {"type": "string"}},
        "output": {"$ref": "#/$defs/output"},
        "final_output": {"$ref": "#/$defs/output"}
      }
    },
    "documentOutput": {
      "type": "object",
      "required": ["quality_mode", "blocked", "pending_review_count", "question_count", "png_count", "metadata_count"],
      "properties": {
        "quality_mode": {"enum": ["strict", "balanced", "legacy"]},
        "blocked": {"type": "boolean"},
        "written": {"type": "boolean"},
        "zip_written": {"type": "boolean"},
        "pending_review_count": {"type": "integer", "minimum": 0},
        "question_count": {"type": "integer", "minimum": 0},
        "png_count": {"type": "integer", "minimum": 0},
        "metadata_count": {"type": "integer", "minimum": 0},
        "warnings": {"type": "array", "items": {"type": "string"}}
      }
    },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": ["page", "width", "height", "role", "raw_proposals", "final_cuts", "review_status"],
      "properties": {
        "page": {"type": "integer", "minimum": 1},
        "width": {"type": "number", "exclusiveMinimum": 0},
        "height": {"type": "number", "exclusiveMinimum": 0},
        "role": {"enum": ["kapak", "icindekiler", "konu", "soru", "cozum", "cevap_anahtari", "karma", "bilinmiyor"]},
        "role_confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "layout_family": {"type": "string"},
        "analysis_error": {"type": ["string", "null"]},
        "review_status": {"enum": ["temiz", "bekliyor", "incele", "onaylandi", "reddedildi", "gerekli_degil", "bilinmiyor"]},
        "risk_reasons": {"type": "array", "items": {"type": "string"}},
        "raw_proposals": {"type": "array", "items": {"$ref": "#/$defs/candidate"}},
        "final_cuts": {"type": "array", "items": {"$ref": "#/$defs/candidate"}}
      }
    },
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "source", "pages", "final_output"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "source": {"type": "string", "minLength": 1},
        "source_hash": {"type": "string"},
        "source_sha256": {"type": "string"},
        "final_output": {"$ref": "#/$defs/documentOutput"},
        "pages": {"type": "array", "items": {"$ref": "#/$defs/page"}}
      }
    }
  }
}
