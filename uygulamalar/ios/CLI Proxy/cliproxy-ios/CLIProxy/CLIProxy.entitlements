<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- İlk grup uygulamanın kendisi (varsayılan kalır); ikincisi İkra ile paylaşılan hesap kasası. -->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)com.mehmetderin.cliproxy</string>
		<string>$(AppIdentifierPrefix)com.mehmetderin.ortak</string>
	</array>
</dict>
</plist>
