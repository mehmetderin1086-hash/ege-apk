t c=s,d=l,m=(p,f)=>{let g=a.find(v=>oT(p,v.box));if(!g)return p;let y=Vr(g.box,f),k=i(y,f);return oT(f,g.box)||k<Hx?p:{x:y.x+(f.x-y.x)*Ji/k,y:y.y+(f.y-y.y)*Ji/k}};return d=m(l,s),c=m(s,d),c===s&&d===l||i(c,d)<Hx?o:(n.push({scene:t,kind:"arrow",detail:"ok ucu bir etiketin yaz\u0131s\u0131na giriyor"}),{...o,points:[c,d]})}),{drawings:n.length?r:e,issues:n}}function cT(e){let t=[];return{scenes:e.map((i,r)=>{let a=YV(i.drawings,r);return t.push(...a.issues),a.issues.length?{...i,drawings:a.drawings}:i}),issues:t}}var Yx=u.enum(["guided","animation","board","quick","classic"]),WV="HAREKET S\xD6ZLE\u015EMES\u0130: motion alan\u0131 yaln\u0131z olay\u0131n ili\u015Fkisini somutla\u015Ft\u0131ran yedek \u015Fematik drawing \xF6\u011Felerinde kullan\u0131l\u0131r. objectID ayn\u0131 nesne i\xE7in b\xFCt\xFCn sahnelerde sabittir; nesnenin temel points koordinatlar\u0131n\u0131 koru. motion.from ve motion.to, temel \u015Fekle uygulanan x/y \xF6telemesi (-1..1), rotation derece (-360..360) ve scale (0.25..3) de\u011Ferlerini ta\u015F\u0131r; n\xF6tr konum x=0,y=0,rotation=0,scale=1. \xD6nceki sahnede ayn\u0131 objectID varsa motion.from alan\u0131n\u0131 atlayarak \xF6nceki motion.to konumundan devam edebilirsin; ilk g\xF6r\xFCn\xFCmde from a\xE7\u0131k\xE7a verilsin. motion.start ve motion.end sahnenin 0..1 zaman oran\u0131d\u0131r, 0<=start<end<=1; hareketi anlat\u0131mdaki olay s\u0131ras\u0131na yerle\u015Ftir. \xC7izimin start de\u011Feri motion.start de\u011Ferinden b\xFCy\xFCk olmas\u0131n: nesnenin g\xF6r\xFCnmesi hareketten \xF6nce veya hareketle birlikte ba\u015Flamal\u0131. \xC7izimin end de\u011Feri motion.start sonras\u0131na uzanabilir; g\xF6r\xFCnt\xFCleyici \xE7izim tamamlan\u0131\u015F\u0131n\u0131 hareket ba\u015Flang\u0131c\u0131na kadar k\u0131salt\u0131r. Ger\xE7ek ili\u015Fkiyi g\xF6steren bir hareket se\xE7; kaynakta olmayan \u015Fekil, a\xE7\u0131, \xF6l\xE7\xFC veya par\xE7a uydurma. Nesne say\u0131s\u0131, kimli\u011Fi ve etiketleri hareket boyunca de\u011Fi\u015Fmesin; hareket yoksa motion alan\u0131n\u0131 atla.",XV="HAREKET MOTORU 2: Bir olay\u0131n a\u015Famalar\u0131 i\xE7in motion.keyframes kullanabilirsin: en \xE7ok 8 ara durak, her biri {at,pose}; motion.start < at < motion.end ve at de\u011Ferleri kesin artan s\u0131rada olsun. at b\xFCt\xFCn sahnenin 0..1 zaman oran\u0131d\u0131r, bir \xF6nceki dura\u011Fa g\xF6re s\xFCre de\u011Fildir. Her pose temel points koordinatlar\u0131na g\xF6re TAM x,y,rotation,scale durumudur; bir \xF6nceki dura\u011Fa eklenecek fark de\u011Fildir. \xD6rne\u011Fin hareket\u2192bekleme\u2192d\xF6nme gerekiyorsa start=0.2,end=0.85; at=0.42 ve at=0.60 i\xE7in ayn\u0131 pose vererek beklet, sonra motion.to i\xE7inde gereken d\xF6n\xFC\u015F\xFC g\xF6ster. Bu yaln\u0131z bir zamanlama \xF6rne\u011Fidir: d\xF6n\xFC\u015F a\xE7\u0131s\u0131 ve \xF6teleme kaynaktan gelmeli; soru gerektirmiyorsa d\xF6nme ekleme. motion.easing yaln\u0131z linear, easeIn, easeOut veya easeInOut olabilir; yoksa easeInOut uygulan\u0131r; e\u015Fit h\u0131zl\u0131 fiziksel harekette linear se\xE7. motion.pivot iste\u011Fe ba\u011Fl\u0131 d\xF6nme/\xF6l\xE7ekleme merkezidir; \xE7izim alan\u0131nda x,y 0..1; ilk g\xF6r\xFCn\xFCmde yoksa \u015Feklin temel s\u0131n\u0131rlar\u0131n\u0131n merkezi kullan\u0131l\u0131r. Ayn\u0131 objectID sonraki sahnede pivot vermezse \xF6nceki a\xE7\u0131k pivot korunur; pivot\u0131 sabit tut. Ger\xE7ekten farkl\u0131 pivot gerekiyorsa from durumunu da yeni merkeze g\xF6re ayarlayarak nesnenin konumunun s\u0131\xE7ramas\u0131n\u0131 \xF6nle. Nesneyle birlikte hareket etmesi gereken etikete parentID ver; bu, AYNI sahnedeki tek bir objectID nesnesine ba\u011Flan\u0131r. Her objectID sahne i\xE7inde benzersiz olsun; \xFCst nesne ba\u011Flant\u0131lar\u0131 d\xF6ng\xFC olu\u015Fturmas\u0131n ve en \xE7ok 4 \xFCst nesne derinli\u011Fi olsun. Ayn\u0131 objectID b\xFCt\xFCn sahnelerde ayn\u0131 kind, temel points ve parentID ile tekrarlans\u0131n; yer de\u011Fi\u015Fimini points alan\u0131n\u0131 de\u011Fi\u015Ftirerek de\u011Fil motion ile ver. Ba\u011Fl\u0131 etiketin points konumu ba\u015Flang\u0131\xE7taki \xE7izim alan\u0131 koordinat\u0131d\u0131r; ana nesnenin d\xF6n\xFC\u015F\xFCm\xFC etikete de uygulan\u0131r. keepUpright ba\u011Fl\u0131 etikette varsay\u0131lan true olur; b\xF6ylece etiketin konumu nesneyi takip ederken yaz\u0131s\u0131 dik ve okunur kal\u0131r. Etiketin ayr\u0131ca ger\xE7ek bir yerel hareketi yoksa ona ikinci bir motion kopyalama. \xDCst nesne ayn\u0131 sahnede \xE7izilsin; kaynakta olmayan nesne, say\u0131, a\xE7\u0131, y\xF6n, bilimsel de\u011Fi\u015Fim veya \xF6l\xE7\xFC \xFCretme. Nesneleri ve etiketlerini hareket boyunca koru; yaln\u0131z anlat\u0131lan olay\u0131n gerektirdi\u011Fi a\u015Famalar\u0131 canland\u0131r.",Gx={guided:"ANLATIM B\u0130\xC7\u0130M\u0130: ADIM ADIM REHBER. \xD6nce sorulan\u0131 ve verilenleri ay\u0131r; ard\u0131ndan y\xF6ntemi neden se\xE7ti\u011Fini s\xF6yle; her ad\u0131mda tek bir i\u015Flem veya \xE7\u0131kar\u0131m yap; \u015F\u0131kl\u0131 soruda her \u015F\u0131kk\u0131n gerek\xE7esini a\xE7\u0131kla; son olarak sonucu kontrol et. \u0130\u015Flemi yaln\u0131z okuma, bir \xF6nceki bilgiden bu ad\u0131ma nas\u0131l ula\u015F\u0131ld\u0131\u011F\u0131n\u0131 \xF6\u011Fret. Her sahne yeni bir bilgi eklesin, ayn\u0131 gerek\xE7eyi tekrar etme.",animation:"ANLATIM B\u0130\xC7\u0130M\u0130: \u015EEKL\u0130 HAREKET ETT\u0130REREK A\xC7IKLA. A\xE7\u0131k/beyaz zeminde renkli, k\u0131sa etiketli ve a\u015Fama a\u015Fama de\u011Fi\u015Fen bir s\xFCre\xE7 tasarla. \xD6nce ba\u015Flang\u0131\xE7 durumunu, sonra tek bir olay\u0131n hangi nesneyi nas\u0131l de\u011Fi\u015Ftirdi\u011Fini, en son yeni durumu anlat. Kaynaktaki nesne kimlikleri, say\u0131lar, etiketler ve y\xF6nler korunsun; hareket yeni veri, atom, kromozom veya \xF6l\xE7\xFC \xFCretmesin. Genel yap\u0131dan ilgili ayr\u0131nt\u0131ya ge\xE7; anlat\u0131lan \xF6\u011Feyi ayn\u0131 c\xFCmlede ad\u0131yla belirt. Sabit foto\u011Fraf\u0131n yan\u0131nda paragraf okumak yeterli de\u011Fildir: anlat\u0131lan olay i\xE7in ger\xE7ek bir yer de\u011Fi\u015Ftirme, olu\u015Fma/ayr\u0131lma, ba\u011Flanma veya de\u011Fi\u015Fim a\u015Famas\u0131 tan\u0131mla. Ger\xE7ek hareket gerektirmeyen bir soruda hareket uydurma; mevcut ili\u015Fkiyi s\u0131ras\u0131yla vurgula. Kaynak ve gerek\xE7e, g\xF6rsel \xFCsluptan \xF6nce gelir.",board:"ANLATIM B\u0130\xC7\u0130M\u0130: TAHTADA \xC7\xD6Z\xDCM. Soru \xFCst\xFCnde yaln\u0131z o anda kullan\u0131lan veriye renkli bir i\u015Faret koy; i\u015Flemleri soruyu kapatmayan yan bo\u015Flukta bir i\u015Flem bir sat\u0131r d\xFCzeninde kur. Her yeni sat\u0131r\u0131n neden geldi\u011Fini anlat. Ayn\u0131 \xF6\u011Fe ayn\u0131 renkte kals\u0131n; yard\u0131mc\u0131 \xE7izgi veya yeni ba\u011F\u0131nt\u0131 gerekti\u011Finde bunu ayr\u0131 bir ad\u0131mda a\xE7\u0131kla. \u015E\u0131klar\u0131 soru \xFCst\xFCnde gerek\xE7eleriyle ele, son sat\u0131rda sa\u011Flamay\u0131 g\xF6ster.",quick:"ANLATIM B\u0130\xC7\u0130M\u0130: HIZLI D\u0130KEY ANLATIM. Tek odakl\u0131 k\u0131sa sahneler kullan: sorulan/verilen, kilit gerek\xE7e ve i\u015Flem, \u015F\u0131k gerek\xE7eleri, sonu\xE7/kontrol. En fazla bir k\u0131sa ba\u015Fl\u0131k ve o anki ba\u011F\u0131nt\u0131 ekranda olsun. K\u0131sal\u0131k i\xE7in bilimsel gerek\xE7eyi, gerekli ara i\u015Flemi, birimi, HER \u015F\u0131kk\u0131n gerek\xE7esini veya sonu\xE7 kontrol\xFCn\xFC atlama; tekrarlar\u0131 ve konu d\u0131\u015F\u0131 giri\u015Fleri \xE7\u0131kar. Bir \xF6\u011Fretim a\u015Famas\u0131 yaln\u0131z ilgili kom\u015Fu a\u015Famayla ayn\u0131 sahnede birle\u015Febilir.",classic:""};function dT(e,t=1){return e!=="animation"?Gx[e]:`${Gx[e]} ${WV} ${t===2?XV:"Bu istemci yaln\u0131z temel from/to hareketini destekler; ara durak, \xFCst nesne ba\u011Flant\u0131s\u0131, \xF6zel e\u011Fri veya \xF6zel d\xF6nme merkezi ekleme."}`}function mT(e,t){return e==="quick"?"3-4 k\u0131sa sahne; s\xFCreyi gerekli do\u011Fru gerek\xE7enin uzunlu\u011Funa g\xF6re belirle, konu\u015Fmay\u0131 h\u0131zland\u0131rarak veya ad\u0131m atlayarak k\u0131saltma.":e==="classic"&&t==="short"?"3-4 k\u0131sa sahne, yakla\u015F\u0131k 1-2 dakika.":t==="short"?"3-4 k\u0131sa sahne, yakla\u015F\u0131k 1-2 dakika. Birbiriyle ili\u015Fkili \xF6\u011Fretim a\u015Famalar\u0131n\u0131 ayn\u0131 sahnede birle\u015Ftirebilirsin; gerekli gerek\xE7e ve kontrol korunsun.":"5-8 sahne, yakla\u015F\u0131k 2-4 dakika."}function pT(e){let t=Gx[e];return t?`${t} Bu istek yaln\u0131z mevcut tek sahneyi d\xFCzeltir; b\xFCt\xFCn \xF6\u011Fretim s\u0131ras\u0131n\u0131 o sahneye s\u0131k\u0131\u015Ft\u0131rma, sahnenin g\xF6revini koru.`:""}var gT=u.object({x:u.number().min(0).max(1),y:u.number().min(0).max(1)}),Wx=u.object({x:u.number().min(-1).max(1).default(0),y:u.number().min(-1).max(1).default(0),rotation:u.number().min(-360).max(360).default(0),scale:u.number().min(.25).max(3).default(1)}),fT=u.string().min(1).max(80).refine(e=>e.trim().length>0,"Empty drawing object ID"),QV=u.object({from:Wx.optional(),to:Wx,start:u.number().min(0).max(.95).default(.2),end:u.number().min(.05).max(1).default(.85),easing:u.enum(["linear","easeIn","easeOut","easeInOut"]).optional(),keyframes:u.array(u.object({at:u.number().min(0).max(1),pose:Wx}).strict()).max(8).optional(),pivot:gT.strict().optional()}).superRefine((e,t)=>{e.end<=e.start&&t.addIssue({code:"custom",message:"Invalid drawing motion timeline",path:["end"]});let n=e.start;for(let[i,r]of(e.keyframes??[]).entries())(r.at<=n||r.at>=e.end)&&t.addIssue({code:"custom",message:"Keyframes must increase strictly between motion start and end",path:["keyframes",i,"at"]}),n=r.at}),eZ=u.object({kind:u.enum(["line","arrow","rect","circle","path","label"]),points:u.array(gT).min(1).max(24),text:u.string().max(80),color:u.enum(["teal","purple","orange","red","gray"]),start:u.number().min(0).max(.9),end:u.number().min(.05).max(1),objectID:fT.optional(),motion:QV.optional(),parentID:fT.optional(),keepUpright:u.boolean().optional()}).refine(e=>e.end>e.start&&(e.kind==="label"||e.points.length>=2)&&(!e.motion||e.start<=e.motion.start),"Invalid drawing timeline or geometry: reveal must begin by motion start"),tZ=u.object({title:u.string().min(1).max(90),narration:u.string().min(20).max(1600),caption:u.string().min(1).max(240),formula:u.string().max(600),visual:u.enum(["source","drawing"]),drawings:u.array(eZ).max(16),kind:u.enum(["step","pause"]).default("step")}).superRefine((e,t)=>{let n=new Map;e.drawings.forEach((o,s)=>{o.objectID&&(n.has(o.objectID)?t.addIssue({code:"custom",message:"Duplicate drawing object ID in scene",path:["drawings",s,"objectID"]}):n.set(o.objectID,s))}),e.drawings.forEach((o,s)=>{o.parentID&&!n.has(o.parentID)&&t.addIssue({code:"custom",message:"Drawing parent must exist in the same scene",path:["drawings",s,"parentID"]})});let i=new Set,r=new Set,a=o=>{if(r.has(o))return;if(i.has(o)){t.addIssue({code:"custom",message:"Drawing parent cycle",path:["drawings",o,"parentID"]});return}i.add(o);let s=e.drawings[o].parentID,l=s?n.get(s):void 0;l!==void 0&&a(l),i.delete(o),r.add(o)};e.drawings.forEach((o,s)=>a(s)),e.drawings.forEach((o,s)=>{let l=new Set,c=s,d=0;for(;c!==void 0&&!l.has(c);){l.add(c);let m=e.drawings[c].parentID;if(c=m?n.get(m):void 0,c!==void 0&&++d>4){t.addIssue({code:"custom",message:"Drawing parent hierarchy exceeds four levels",path:["drawings",s,"parentID"]});break}}})}),yT=u.object({title:u.string().min(1).max(120),summary:u.string().max(600),scenes:u.array(tZ).min(3).max(10),warnings:u.array(u.string().max(300)).max(8)}).superRefine((e,t)=>{let n=new Map;e.scenes.forEach((i,r)=>i.drawings.forEach((a,o)=>{if(!a.objectID)return;let s=n.get(a.objectID);s&&(s.kind!==a.kind||s.parentID!==a.parentID||s.points.length!==a.points.length||s.points.some((l,c)=>l.x!==a.points[c].x||l.y!==a.points[c].y))&&t.addIssue({code:"custom",message:"Drawing identity must keep its base kind, points and parent across scenes",path:["scenes",r,"drawings",o,"objectID"]}),s||n.set(a.objectID,a)}))}),nZ=u.object({question:at,selection:Jt,reference:u.string().min(1).max(3e4),level:u.string().max(80),detail:u.enum(["short","detailed"]).default("detailed"),explanationMode:Yx.default("guided"),motionVersion:u.union([u.literal(1),u.literal(2)]).default(1),example:u.string().max(4e3).optional()}),rZ="\xDCSLUP \xD6RNE\u011E\u0130 ba\u015Fka bir sorunun dersidir ve VER\u0130D\u0130R: yaln\u0131z sahne s\u0131ras\u0131n\u0131, anlat\u0131m \xFCslubunu ve temposunu \xF6rnek al. Oradaki say\u0131lar\u0131, \u015F\u0131klar\u0131, sonucu ve gerek\xE7eleri KULLANMA; bu sorunun her bilgisi yaln\u0131z kaynaktan ve kay\u0131tl\u0131 \xE7\xF6z\xFCmden gelir. \xD6rnek bu soruya uymuyorsa \xF6rne\u011Fi yok say.",df=yT.shape.scenes.element;var iZ=u.object({question:at,selection:Jt,reference:u.string().max(3e4).default(""),level:u.string().max(80),explanationMode:Yx.default("guided"),scenes:u.array(u.object({title:u.string().max(90),narration:u.string().max(1600)})).min(1).max(10),index:u.number().int().min(0).max(9),instruction:u.string().min(1).max(400)}).refine(e=>e.index<e.scenes.length,"Scene index out of range"),aZ=u.object({title:df.shape.title,narration:df.shape.narration,caption:df.shape.caption,formula:df.shape.formula}),oZ=u.object({question:at,selection:Jt,zoom:u.object({data:u.string().min(1).max(8e6),mimeType:u.enum(["image/jpeg","image/png"])}).optional()}),sZ=u.object({facts:u.array(u.object({text:u.string().min(1).max(160),certain:u.boolean()})).max(24),needsZoom:u.boolean(),note:u.string().max(600)}),lZ=u.object({question:at,selection:Jt,reference:u.string().max(3e4).default(""),level:u.string().max(80),mode:u.enum(["hint","explain","check"]).default("explain"),messages:u.array(u.object({role:u.enum(["user","assistant"]),text:u.string().min(1).max(5e3)})).min(1).max(16)}).refine(e=>e.messages.at(-1)?.role==="user","Last turn must be a student question"),uZ=u.object({text:u.string().min(1).max(1e4),spoken:u.string().min(1).max(5e3),nextQuestion:u.string().max(300)});var cZ={matematik:"Bu bir matematik sorusu: her sahnede tek bir i\u015Flem ad\u0131m\u0131 g\xF6ster ve ara i\u015Flemi atlama; formula alan\u0131na o ad\u0131m\u0131n i\u015Flemini yaz, son sahnede sonucu yerine koyarak sa\u011Fla.",geometri:"Bu bir geometri sorusu: \u015Fekli \xF6nce yaln\u0131z verilenlerle kur, yard\u0131mc\u0131 \xE7izgiyi ayr\u0131 bir sahnede ekle; ayn\u0131 kenar\u0131 ve a\xE7\u0131y\u0131 her sahnede ayn\u0131 renkle \xE7iz.",fizik:"Bu bir fizik sorusu: \xF6nce cisme etkiyen kuvvetleri ya da verilen b\xFCy\xFCkl\xFCkleri \u015Femayla g\xF6ster, sonra kullan\u0131lan ba\u011F\u0131nt\u0131y\u0131 yaz, en sonda birimleriyle hesapla.",kimya:"Bu bir kimya sorusu: tepkime varsa \xF6nce denklemi ve atom denkli\u011Fini g\xF6ster, sonra mol ili\u015Fkisini kur, en sonda birimleriyle hesapla.",biyoloji:"Bu bir biyoloji sorusu: s\xFCreci a\u015Fama a\u015Fama anlat; \xE7aprazlamada \xF6nce gametleri, sonra olas\u0131l\u0131klar\u0131 g\xF6ster; yap\u0131 sorular\u0131nda par\xE7an\u0131n g\xF6revini s\xF6yle.",turkce:"Bu bir T\xFCrk\xE7e ya da edebiyat sorusu: \xF6nce sorulan c\xFCmleyi ya da paragraf\u0131n ilgili b\xF6l\xFCm\xFCn\xFC aynen g\xF6ster, sonra kural\u0131 ya da ipucunu s\xF6yle, yanl\u0131\u015F \u015F\u0131klar\u0131n neden elendi\u011Fini k\u0131saca belirt.",tarih:"Bu bir tarih sorusu: olaylar\u0131 tarih s\u0131ras\u0131yla ver, her olay\u0131n nedenini ve sonucunu ay\u0131r; kaynakta olmayan tarih yazma.",cografya:"Bu bir co\u011Frafya sorusu: verilen grafik, harita ya da tablodaki de\u011Feri \xF6nce oku, sonra bu de\u011Ferin hangi co\u011Frafi ko\u015Fulu g\xF6sterdi\u011Fini a\xE7\u0131kla.",felsefe:"Bu bir felsefe ya da din k\xFClt\xFCr\xFC sorusu: \xF6nce kavram\u0131 tan\u0131mla, sonra metindeki g\xF6r\xFC\u015Fle e\u015Fle\u015Ftir, en sonda \xF6b\xFCr se\xE7eneklerin neden uymad\u0131\u011F\u0131n\u0131 s\xF6yle.",genel:""},hT=(e,t)=>cZ[an(e,t)],dZ='S\xD6ZEL SORU (\u015Fekli yok): her sahne tahtaya \xE7izilecek somut bir \u015Fey anlats\u0131n ve anlat\u0131m onu ad\u0131yla tarif etsin: s\xFCre\xE7 ya da d\xF6n\xFC\u015F\xFCm \u2192 oklu zincir ("glikozdan pir\xFCvata, oradan laktik aside"), yap\u0131 ya da d\xFCzenek \u2192 kesit ya da par\xE7alar\u0131n yerle\u015Fimi ("zar\u0131n d\u0131\u015F\u0131nda \u2026 i\xE7inde \u2026"), say\u0131sal ili\u015Fki ya da de\u011Fi\u015Fim \u2192 grafik (eksenleri ve e\u011Frinin y\xF6n\xFCn\xFC s\xF6yle), kar\u015F\u0131la\u015Ft\u0131rma ya da s\u0131n\u0131fland\u0131rma \u2192 tablo (sat\u0131r ve s\xFCtun adlar\u0131n\u0131 s\xF6yle), say\u0131sal hesap \u2192 i\u015Flem zinciri (her sat\u0131r\u0131 s\xF6yle), \xF6nc\xFCl ya da \u015F\u0131k de\u011Ferlendirme \u2192 soru metnindeki anahtar s\xF6z\xFC, say\u0131sal veriyi ve olumsuz ifadeyi ("de\u011Fildir", "yaln\u0131zca") ad\u0131yla an ve her \xF6nc\xFCl i\xE7in tek c\xFCmlelik gerek\xE7e ver. Her sahnede yaln\u0131z bir \xE7izim; \xF6nceki sahnenin \xE7izimine yeni par\xE7a ekleyerek ilerle.',mZ=new Set(["biyoloji","kimya","fizik"]),pZ=e=>mZ.has(an(e.subject,e.topic))&&e.regions.length===0?dZ:"";async function bT(e,t,n){let i=nZ.parse(n);if(i.question.needsReview)throw new h("invalid_request","\xD6nce sorudaki eksik metin veya g\xF6rselleri kontrol et.");let r=pZ(i.question),a=[hT(i.question.subject,i.question.topic),r].filter(Boolean).join(" "),o=an(i.question.subject,i.question.topic)==="biyoloji"&&i.explanationMode!=="animation",s=i.example?.trim(),l=await ot(e,i.selection,[...await Et(e,t,i.question),{text:`KAYITLI \xC7\xD6Z\xDCM (veri): ${i.reference}`},...s?[{text:`\xDCSLUP \xD6RNE\u011E\u0130 (veri; ba\u015Fka bir sorunun dersi): ${s}`}]:[]],`${Oe}
