${i}`}function NJ(e){return{type:"object",properties:{speaker:{type:"string",enum:e?.guest?["A","B","C"]:["A","B"]},text:{type:"string"},style:{type:"string"},sourcePage:{type:["integer","null"]},think:{type:["number","null"]}},required:["speaker","text","style","sourcePage","think"]}}function JN(e){return{type:"array",items:{type:"object",properties:{turns:{type:"array",items:NJ(e)}},required:["turns"]}}}function Uw(e){return{type:"object",properties:{scenes:JN(e)},required:["scenes"]}}var mde=Uw();function Bw(e){let t={};return e?.mixedFormat&&(t.style={type:"string",enum:[...tc]}),e?.guest&&(t.guest={type:"boolean"}),{type:"object",properties:{title:{type:"string"},summary:{type:"string"},keyPoints:{type:"array",items:{type:"string"}},sourceNotes:{type:"string"},chapters:{type:"array",items:{type:"object",properties:{title:{type:"string"},goals:{type:"array",items:{type:"string"}},sourcePages:{type:"array",items:{type:"integer"}},targetMinutes:{type:"number"},...t},required:["title","goals","sourcePages","targetMinutes",...Object.keys(t)]}}},required:["title","summary","keyPoints","sourceNotes","chapters"]}}var pde=Bw();function Fw(e){let t=e?.mixedFormat?{style:{type:"string",enum:[...tc]}}:{};return{type:"object",properties:{title:{type:"string"},summary:{type:"string"},keyPoints:{type:"array",items:{type:"string"}},chapters:{type:"array",items:{type:"object",properties:{title:{type:"string"},scenes:JN(e),...t},required:["title","scenes",...Object.keys(t)]}},sourceNotes:{type:"string"}},required:["title","summary","keyPoints","chapters","sourceNotes"]}}var fde=Fw();function GN(e,t,n,i=15,r=!1){return`Sen bir ders \xE7al\u0131\u015Fma materyali haz\u0131rlay\u0131c\u0131s\u0131n. Verilen kaynak notlar\u0131na dayanarak T\xFCrk\xE7e quiz ve bilgi kartlar\u0131 \xFCret. Seviye: ${e}.

KURALLAR
- YALNIZCA kaynak notlar\u0131ndaki bilgiyi kullan; d\u0131\u015Far\u0131dan bilgi ekleme.
- Tam ${t} adet \xE7oktan se\xE7meli soru \xFCret. Her sorunun tam 4 se\xE7ene\u011Fi olsun, yaln\u0131zca biri do\u011Fru olsun, yanl\u0131\u015F se\xE7enekler makul ve ay\u0131rt edici olsun.
- answerIndex 0-3 aras\u0131 do\u011Fru se\xE7ene\u011Fin s\u0131f\u0131r tabanl\u0131 indeksidir. Do\u011Fru cevaplar\u0131n se\xE7enekler (0, 1, 2, 3) aras\u0131nda dengeli da\u011F\u0131lmas\u0131na dikkat et; hep ayn\u0131 \u015F\u0131kka koyma.
- Her soru i\xE7in k\u0131sa bir a\xE7\u0131klama yaz (neden do\u011Fru oldu\u011Fu, kayna\u011Fa dayal\u0131). Notlarda sayfa referans\u0131 varsa sourcePage'e yaz, yoksa null.
