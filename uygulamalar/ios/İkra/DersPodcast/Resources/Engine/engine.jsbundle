\xC7\u0131kt\u0131 yaln\u0131zca verilen JSON \u015Femas\u0131na uygun JSON olsun.`}function FN(e){return`Yukar\u0131daki kaynaklardan ${e.durationMin} dakikal\u0131k ${e.format==="tekAnlatici"?`${e.hostA.name} anlat\u0131m\u0131yla`:`${e.hostA.name} ve ${e.hostB.name} sunumunda`} ders podcast'i senaryosunu haz\u0131rla.`}function Dw(e){return Math.min(15,Math.max(5,Math.round(e/4)))}function qN(e){let t=Dw(e.durationMin);return`${eo(e)}

